{
  "name": "sendbunny",
  "version": "0.1.2",
  "description": "Official Node.js SDK for SendBunny, the agentic AI email platform for developers: a free email API with React Email support, in your own AWS account on Amazon SES, about $0.10 per 1,000 emails. A Resend alternative.",
  "license": "MIT",
  "author": "SendBunny (https://sendbunny.co)",
  "homepage": "https://github.com/sendbunny/sendbunny-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendbunny/sendbunny-node.git"
  },
  "bugs": {
    "url": "https://github.com/sendbunny/sendbunny-node/issues"
  },
  "keywords": [
    "sendbunny",
    "email",
    "email-api",
    "send-email",
    "transactional-email",
    "react-email",
    "resend-alternative",
    "amazon-ses",
    "aws-ses",
    "ses",
    "ai-agents",
    "mcp",
    "webhooks",
    "standard-webhooks",
    "nodejs",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm",
    "dist/cjs"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "ci": "npm run typecheck && npm run build && npm test && npm run check:pack"
  },
  "peerDependencies": {
    "@react-email/render": ">=1.1.0",
    "react-email": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    },
    "react-email": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
