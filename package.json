{
  "name": "sendbunny",
  "version": "0.1.0",
  "description": "Official SendBunny SDK for Node.js and edge runtimes: send email, add contacts, track events and verify webhooks from your own SendBunny install.",
  "license": "MIT",
  "author": "SendBunny (https://sendbunny.co)",
  "homepage": "https://github.com/sendbunny/sendbunny-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendbunny/sendbunny-node.git"
  },
  "bugs": {
    "url": "https://github.com/sendbunny/sendbunny-node/issues"
  },
  "keywords": [
    "sendbunny",
    "email",
    "transactional-email",
    "email-api",
    "aws-ses",
    "ses",
    "webhooks",
    "standard-webhooks",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm",
    "dist/cjs"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "ci": "npm run typecheck && npm run build && npm test && npm run check:pack"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
